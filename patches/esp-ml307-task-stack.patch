From: Nealcn <nealcn@users.noreply.github.com>
Subject: [PATCH] esp-ml307: 增大 MQTT/UDP 任务栈防 AI 对话栈溢出崩溃

AI 对话崩溃重启排查(2026-08-20, 详见 docs/DEBUG_NOTES.md 第三节第 7 条):

1. esp-mqtt 任务栈 4096 -> 8192:
   MQTT over SSL(8883) 的 TLS 握手在 esp-mqtt 任务内执行, 且 MQTT_EVENT_DATA
   的 JSON 解析(deserializeJson/serializeJson + string 构造)也在该任务上下文,
   4KB 实测栈溢出 -> 崩溃伪装成堆损坏/跳飞/随机复位。

2. UDP 接收任务栈 3072 -> 6144:
   回调链 = recv(lwIP) + AES-CTR(mbedtls 栈上 context) + AudioStreamPacket
   构造 + ChatEngine 队列 push, 持续音频流下 3KB 不足。

应用方式: 在项目根目录执行
  git apply patches/esp-ml307-task-stack.patch
(managed_components/78__esp-ml307/ 每次组件管理器重新拉取/升级后会还原,
  需重新应用)

---
 managed_components/78__esp-ml307/src/esp/esp_mqtt.cc | 6 +++++-
 managed_components/78__esp-ml307/src/esp/esp_udp.cc   | 4 +++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/managed_components/78__esp-ml307/src/esp/esp_mqtt.cc b/managed_components/78__esp-ml307/src/esp/esp_mqtt.cc
index 5ce6590..c3c7be0 100644
--- a/managed_components/78__esp-ml307/src/esp/esp_mqtt.cc
+++ b/managed_components/78__esp-ml307/src/esp/esp_mqtt.cc
@@ -21,7 +21,11 @@
     }
 
     esp_mqtt_client_config_t mqtt_config = {};
-    mqtt_config.task.stack_size = 4096;
+    // 栈 8KB：MQTT over SSL(8883) 的 TLS 握手在 esp-mqtt 任务内执行（esp-tls +
+    // mbedtls 证书解析，官方建议 6144+，4096 实测栈溢出 → 崩溃伪装成随机错误）；
+    // MQTT_EVENT_DATA 的 JSON 解析（deserializeJson/serializeJson + string 构造）
+    // 也在此任务上下文，4KB 实测溢出。
+    mqtt_config.task.stack_size = 8192;
     mqtt_config.broker.address.hostname = broker_address.c_str();
     mqtt_config.broker.address.port = broker_port;
     if (broker_port == 8883) {
diff --git a/managed_components/78__esp-ml307/src/esp/esp_udp.cc b/managed_components/78__esp-ml307/src/esp/esp_udp.cc
index 61db95a..a08e5ca 100644
--- a/managed_components/78__esp-ml307/src/esp/esp_udp.cc
+++ b/managed_components/78__esp-ml307/src/esp/esp_udp.cc
@@ -61,12 +61,14 @@
     connected_ = true;
 
     xEventGroupClearBits(event_group_, ESP_UDP_EVENT_RECEIVE_TASK_EXIT);
+    // 栈 6KB：回调链 = recv(lwIP) + AES-CTR(mbedtls 栈上 context) + AudioStreamPacket
+    // 构造 + ChatEngine 队列 push，3KB 实测不足（持续音频流下栈溢出风险）。
     xTaskCreate([](void* arg) {
         EspUdp* udp = (EspUdp*)arg;
         udp->ReceiveTask();
         xEventGroupSetBits(udp->event_group_, ESP_UDP_EVENT_RECEIVE_TASK_EXIT);
         vTaskDelete(NULL);
-    }, "udp_receive", 3072, this, 1, &receive_task_handle_);
+    }, "udp_receive", 6144, this, 1, &receive_task_handle_);
     return true;
 }
 
-- 
